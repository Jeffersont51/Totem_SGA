<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootConfirmScheduling"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Header Decoration -->
    <br.com.jefferson.totemsga.util.StaticWaveView
        android:id="@+id/viewTopDecorationBack"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:isTop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <br.com.jefferson.totemsga.util.FlowGradientView
        android:id="@+id/viewTopDecoration"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:isTop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivLogoScheduling"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_marginTop="2dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_gallery"
        app:layout_constraintTop_toBottomOf="@+id/viewTopDecoration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationZ="10dp"/>

    <!-- Bottom Decoration -->
    <br.com.jefferson.totemsga.util.StaticWaveView
        android:id="@+id/viewBottomDecorationBack"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:isTop="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <br.com.jefferson.totemsga.util.FlowGradientView
        android:id="@+id/viewBottomDecoration"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:isTop="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/llConfirmSchedulingContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoScheduling"
        app:layout_constraintBottom_toTopOf="@+id/viewBottomDecoration">

        <ScrollView
            android:id="@+id/svConfirmScheduling"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempo restante: 30s"
                    android:textColor="#FF0000"
                    android:layout_gravity="end"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins"/>

                <!-- Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="#15F47B20"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_calendar"
                            app:tint="#F47B20"
                            android:contentDescription="Ícone de Agendamento"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JÁ TENHO\nAGENDAMENTO"
                        android:textSize="28sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#333333" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirme sua presença"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins"
                        android:textColor="#666666" />
                </LinearLayout>

                <!-- Document Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione o tipo de documento:"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins"/>

                <RadioGroup
                    android:id="@+id/rgDocumentType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbCPF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPF"
                        android:checked="true"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/poppins"/>

                    <RadioButton
                        android:id="@+id/rbCNPJ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CNPJ"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/poppins"/>

                    <RadioButton
                        android:id="@+id/rbPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone"
                        android:fontFamily="@font/poppins"/>
                </RadioGroup>

                <!-- Input Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="CPF"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="#F47B20"
                    app:hintTextColor="#F47B20"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:fontFamily="@font/poppins"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSearch"
                    style="@style/Widget.Totem.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CONSULTAR"
                    android:layout_marginBottom="16dp" />

                <!-- Dynamic Error Message -->
                <TextView
                    android:id="@+id/tvErrorAgendamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#E31E24"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:fontFamily="@font/poppins"/>

                <!-- Result Container -->
                <LinearLayout
                    android:id="@+id/llResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResultHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Agendamento de hoje encontrado:"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/poppins"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSchedulings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirm"
                        style="@style/Widget.Totem.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CONFIRMAR PRESENÇA"
                        android:backgroundTint="#2ECC71"
                        android:visibility="gone"/>
                </LinearLayout>

                <!-- Loading State -->
                <ProgressBar
                    android:id="@+id/progressSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="#F47B20"/>

            </LinearLayout>
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Totem.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="VOLTAR"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="#F47B20"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
