<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSelection"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Header Decoration -->
    <br.com.jefferson.totemsga.util.StaticWaveView
        android:id="@+id/viewTopDecorationBack"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:isTop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <br.com.jefferson.totemsga.util.FlowGradientView
        android:id="@+id/viewTopDecoration"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:isTop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivLogoSelection"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/viewTopDecoration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationZ="10dp"/>

    <!-- Bottom Decoration -->
    <br.com.jefferson.totemsga.util.StaticWaveView
        android:id="@+id/viewBottomDecorationBack"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:isTop="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <br.com.jefferson.totemsga.util.FlowGradientView
        android:id="@+id/viewBottomDecoration"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:isTop="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/llSelectionContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoSelection"
        app:layout_constraintBottom_toTopOf="@+id/viewBottomDecoration">

        <!-- Header Redesign -->
        <LinearLayout
            android:id="@+id/llHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_icon"
                android:backgroundTint="#15F47B20"
                android:layout_marginBottom="4dp">
                <ImageView
                    android:id="@+id/ivHeaderIcon"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_building"
                    app:tint="#F47B20"/>
            </FrameLayout>

            <TextView
                android:id="@+id/tvSelectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escolha um\ndepartamento"
                android:textSize="28sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvItems"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"/>

        <!-- Appointment Confirmation Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardScheduling"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="2dp"
            app:strokeColor="#F47B20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="#F47B20"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JÁ TENHO AGENDAMENTO"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:fontFamily="@font/poppins"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirme sua presença"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:fontFamily="@font/poppins"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#F47B20"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reprint Ticket Button -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardReprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:strokeWidth="2dp"
            app:strokeColor="#F47B20"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_document_seal"
                    app:tint="#F47B20"
                    android:layout_marginEnd="16dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REIMPRIMIR SENHA"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#333333"
                        android:fontFamily="@font/poppins"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recupere sua última senha"
                        android:textSize="14sp"
                        android:textColor="#666666"
                        android:fontFamily="@font/poppins"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#F47B20"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/llError"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Falha ao carregar dados"
                android:textSize="20sp"
                android:layout_marginBottom="16dp"/>

            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TENTAR NOVAMENTE"
                android:padding="16dp"/>
        </LinearLayout>

        <!-- Secondary Back Button at Bottom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackSelectionSecondary"
            style="@style/Widget.Totem.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOLTAR"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="#F47B20"
            android:visibility="gone"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>