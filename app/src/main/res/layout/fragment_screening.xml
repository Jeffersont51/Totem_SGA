<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScreening"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top Header Decoration -->
    <br.com.jefferson.totemsga.util.StaticWaveView
        android:id="@+id/viewTopDecorationBack"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        app:isTop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <br.com.jefferson.totemsga.util.FlowGradientView
        android:id="@+id/viewTopDecoration"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:isTop="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageView
        android:id="@+id/ivLogoScreening"
        android:layout_width="200dp"
        android:layout_height="100dp"
        android:layout_marginTop="2dp"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/viewTopDecoration"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:translationZ="10dp"/>

    <!-- Bottom Decoration -->
    <br.com.jefferson.totemsga.util.StaticWaveView
        android:id="@+id/viewBottomDecorationBack"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:isTop="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <br.com.jefferson.totemsga.util.FlowGradientView
        android:id="@+id/viewBottomDecoration"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:isTop="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/llScreeningContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@+id/ivLogoScreening"
        app:layout_constraintBottom_toTopOf="@+id/viewBottomDecoration">

        <ScrollView
            android:id="@+id/svScreening"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Top Row Container (Back Button) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">

                    <!-- Top Back Button Hidden (Using Bottom Button only) -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnBackScreening"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:icon="@drawable/ic_arrow_back"
                        app:iconTint="#FFFFFF"
                        app:iconSize="24dp"
                        android:padding="0dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        android:visibility="gone"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tempo restante: 30s"
                    android:textColor="#FF0000"
                    android:layout_gravity="end"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins"/>

                <!-- Header Redesign -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <FrameLayout
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="#15F47B20"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:id="@+id/ivHeaderIcon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_clipboard_check"
                            app:tint="#F47B20"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvScreeningTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Faça sua\nidentificação"
                        android:textSize="28sp"
                        android:fontFamily="@font/poppins"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:lineSpacingExtra="4dp"/>
                </LinearLayout>

                <!-- Form Content -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione o tipo de documento:"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/poppins"/>

                <RadioGroup
                    android:id="@+id/rgDocumentType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="16dp">

                    <RadioButton
                        android:id="@+id/rbCPF"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPF"
                        android:checked="true"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/poppins"/>

                    <RadioButton
                        android:id="@+id/rbCNPJ"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CNPJ"
                        android:layout_marginEnd="16dp"
                        android:fontFamily="@font/poppins"/>

                    <RadioButton
                        android:id="@+id/rbPhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone"
                        android:fontFamily="@font/poppins"/>
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDocumento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="CPF"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="16dp"
                    app:boxStrokeColor="#F47B20"
                    app:hintTextColor="#F47B20"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDocumento"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:fontFamily="@font/poppins"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nome Completo"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="8dp"
                    app:boxStrokeColor="#F47B20"
                    app:hintTextColor="#F47B20"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNome"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:fontFamily="@font/poppins"/>
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvAutoFilledHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Encontrado no cadastro - confira e edite se necessário"
                    android:textColor="#666666"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    android:fontFamily="@font/poppins"/>

                <!-- Dynamic Error Message -->
                <TextView
                    android:id="@+id/tvErrorTriagem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#E31E24"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:fontFamily="@font/poppins"/>

                <TextView
                    android:id="@+id/tvPrioridadeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecione a Prioridade"
                    android:layout_gravity="start"
                    android:layout_marginBottom="12dp"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:fontFamily="@font/poppins"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPrioridades"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:nestedScrollingEnabled="false"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGerarSenha"
                    style="@style/Widget.Totem.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GERAR SENHA"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Secondary Back Button at Bottom -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackScreeningSecondary"
            style="@style/Widget.Totem.Button.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:text="VOLTAR"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="#F47B20"/>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>